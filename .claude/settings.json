{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(?!mcp__copland__)",
        "hooks": [{ "type": "mcp_tool", "server": "copland", "tool": "heartbeat", "timeout": 10 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "mcp_tool", "server": "copland", "tool": "heartbeat", "timeout": 10 }]
      }
    ]
  }
}
